# Public desktop client configuration, supplied to the desktop build environment.
# Register this public OAuth client with the identity service and allow the
# loopback callback http://127.0.0.1:<ephemeral-port>/callback with PKCE S256.
ONEMAIL_JYI_CLIENT_ID=onemail-desktop
ONEMAIL_JYI_AUTH_ORIGIN=https://ai.jyisolutions.com
ONEMAIL_JYI_GATEWAY_ORIGIN=https://gateway.jyisolutions.com
# Never place a shared service key, mailbox password, or OAuth client secret here.
