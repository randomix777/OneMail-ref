# OneMail — VPS / Docker production environment
#
# Copy this file to `.env` next to `docker-compose.yml` and fill every value.
# `.env` is gitignored; never commit real secrets.
#
# Generate secrets with:
#   openssl rand -hex 32   # AUTH_SECRET, EMAIL_ENCRYPT_SECRET, API_KEY_SALT,
#                          # INTERNAL_API_KEY, CRON_SECRET, REDIS_HTTP_TOKEN
#   openssl rand -hex 16   # EMAIL_ENCRYPT_SALT
#   openssl rand -base64 32 # POSTGRES_PASSWORD (or any strong password)

# ---------------------------------------------------------------- basics ----
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://onemail.jyisolutions.com
NEXT_PUBLIC_BRAND_NAME=OneMail
# Tells every compose service which env file to read.
INBOX_ZERO_ENV_FILE=./.env
# Image for web + worker. Defaults to the published multi-arch image; set it to
# onemail:local when you build from source on this host (see README §3).
# ONEMAIL_IMAGE=onemail:local

# ------------------------------------------------------------- postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=inboxzero
# Keep both URLs identical; the app uses DIRECT_URL for migrations.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/inboxzero?schema=public
DIRECT_URL=postgresql://postgres:CHANGE_ME@db:5432/inboxzero?schema=public
# A fresh database applies all 302 migrations on first boot; the image defaults
# to 320s, which is tight on a small VM.
MIGRATION_TIMEOUT_SECONDS=900
# Bind published DB/Redis ports to loopback only.
POSTGRES_BIND_HOST=127.0.0.1
REDIS_BIND_HOST=127.0.0.1
WEB_PORT=3000

# ---------------------------------------------------------------- redis ----
# bullmq = durable queue consumed by the `queue-worker` profile.
QUEUE_BACKEND=bullmq
REDIS_URL=redis://redis:6379
# Upstash REST-compatible shim used for caches and rate limits.
REDIS_HTTP_URL=http://serverless-redis-http:80
REDIS_HTTP_TOKEN=CHANGE_ME

INTERNAL_API_URL=http://web:3000

# -------------------------------------------------------------- secrets ----
AUTH_SECRET=CHANGE_ME
EMAIL_ENCRYPT_SECRET=CHANGE_ME
EMAIL_ENCRYPT_SALT=CHANGE_ME
API_KEY_SALT=CHANGE_ME
INTERNAL_API_KEY=CHANGE_ME
CRON_SECRET=CHANGE_ME
HEALTH_API_KEY=CHANGE_ME

# --------------------------------------------------------------- google ----
# Mailbox sign-in (Gmail). Placeholders keep env validation happy; replace with
# real OAuth credentials before users connect Gmail.
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# ------------------------------------------------- JYI Firebase handoff ----
# The account-centre one-time-ticket login, same as the other JYI brands.
FIREBASE_HANDOFF_ENABLED=true
FIREBASE_ACCOUNT_ORIGIN=https://account.jyisolutions.com
FIREBASE_HANDOFF_CLIENT_ID=onemail-web
# Must equal the JYI Worker secret FIREBASE_CLIENT_SECRET_ONEMAIL.
FIREBASE_CLIENT_SECRET_ONEMAIL=CHANGE_ME

# ------------------------------------------------- optional: AI features ----
# Any supported provider key enables the assistant; without one, AI features stay off.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# ---------------------------------------------------- optional: tunnel ------
# Only needed with docker-compose.tunnel.yml. Create the tunnel in the
# Cloudflare Zero Trust dashboard and paste its token here.
TUNNEL_TOKEN=
